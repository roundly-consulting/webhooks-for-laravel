{
    "name": "roundly-consulting/webhooks-for-laravel",
    "description": "Receive and send signed webhooks in Laravel: verified per-sender endpoints with replay protection and queued handlers, retried and throttled deliveries, secret rotation, an SSRF guard and a delivery log.",
    "keywords": [
        "webhooks",
        "webhook-signature",
        "hmac",
        "standard-webhooks",
        "rfc9421",
        "ssrf",
        "retries",
        "delivery-log"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/webhooks-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/webhooks-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/encryption": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/validation": "^13.0",
        "roundly-consulting/crypto-for-laravel": "^2.1",
        "roundly-consulting/enums-for-laravel": "^2.0",
        "roundly-consulting/http-client-rate-limits-for-laravel": "^2.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0",
        "roundly-consulting/safe-fetch-for-laravel": "@dev",
        "roundly-consulting/sentinel-for-laravel": "^2.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.5",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "suggest": {
        "ext-intl": "International (IDN) webhook host names; without it they are refused."
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Webhooks\\": "src",
            "RoundlyConsulting\\Webhooks\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Webhooks\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Webhooks\\WebhooksServiceProvider"
            ],
            "aliases": {
                "Webhooks": "RoundlyConsulting\\Webhooks\\Facades\\Webhooks"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../safe-fetch-for-laravel*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/roundly-consulting/safe-fetch-for-laravel",
            "no-api": true
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
